# Salin menjadi .env lalu sesuaikan.
PORT=3000
HOST=127.0.0.1
DB_PATH=data/rich-gallery.db
BACKUP_DIR=data/backup
# Wajib true setelah HTTPS aktif (certbot), supaya cookie login hanya dikirim lewat https.
COOKIE_SECURE=true
# true karena aplikasi berjalan di belakang nginx.
TRUST_PROXY=true
# Zona waktu toko (Indramayu = WIB).
TZ_TOKO=Asia/Jakarta
SESSION_DAYS=30
SYNC_INTERVAL_SEC=60
BACKUP_KEEP_DAYS=30
