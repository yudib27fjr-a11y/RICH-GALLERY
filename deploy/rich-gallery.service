[Unit]
Description=Rich Gallery (kasir & stok)
After=network.target

[Service]
Type=simple
User=richgallery
WorkingDirectory=/opt/rich-gallery
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Pengamanan dasar
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/rich-gallery/data

[Install]
WantedBy=multi-user.target
